; Engine configuration file for Isla del Ahogado.
; Godot 4.x project bootstrap: systems and content arrive in later prompts.

config_version=5

[application]

config/name="Isla del Ahogado"
config/description="Andamiaje de un juego de gestión y aventura pirata con humor negro."
run/main_scene="res://scenes/world/world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameManager="*res://autoloads/game_manager.gd"
TimeManager="*res://autoloads/time_manager.gd"
SaveManager="*res://autoloads/save_manager.gd"
InventorySystem="*res://autoloads/inventory_system.gd"
EconomyManager="*res://autoloads/economy_manager.gd"
FaithManager="*res://autoloads/faith_manager.gd"
CemeteryManager="*res://autoloads/cemetery_manager.gd"
TechTreeManager="*res://autoloads/tech_tree_manager.gd"
QuestManager="*res://autoloads/quest_manager.gd"
DialogueManager="*res://autoloads/dialogue_manager.gd"
AbyssManager="*res://autoloads/abyss_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

